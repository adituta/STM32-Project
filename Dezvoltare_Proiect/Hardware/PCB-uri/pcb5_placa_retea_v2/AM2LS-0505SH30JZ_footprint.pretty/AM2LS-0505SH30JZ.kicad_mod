(footprint "Aimtec_SIP_1W_DCDC_5Pin"
    (version 20221018)
    (generator "pcbnew")
    (layer "F.Cu")
    (descr "Aimtec 1W isolated DC-DC converter, SIP, 5 pini THT (1,2,4,5,8), corp 13.2x8.5mm, distanta randuri 12.2mm, pitch 2.54mm")
    (tags "Aimtec DC-DC SIP converter")
    (attr through_hole)
    (fp_text reference "REF**" (at 1.44 -2.5) (layer "F.SilkS")
        (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text value "Aimtec_SIP_DCDC" (at 1.44 14) (layer "F.Fab")
        (effects (font (size 1 1) (thickness 0.15)))
    )

    ; Conturul corpului (13.20mm lungime x 8.50mm latime)
    (fp_line (start -2.81 -0.5) (end 5.69 -0.5) (layer "F.SilkS") (width 0.15))
    (fp_line (start 5.69 -0.5) (end 5.69 12.7) (layer "F.SilkS") (width 0.15))
    (fp_line (start 5.69 12.7) (end -2.81 12.7) (layer "F.SilkS") (width 0.15))
    (fp_line (start -2.81 12.7) (end -2.81 -0.5) (layer "F.SilkS") (width 0.15))

    ; Marcaj Pin 1
    (fp_circle (center -2.3 0) (end -2.0 0) (layer "F.SilkS") (width 0.15) (fill solid))

    ; Courtyard
    (fp_rect (start -3.06 -0.75) (end 5.94 12.95) (layer "F.CrtYd") (width 0.05))

    ; Pini
    (pad "1" thru_hole rect (at 0 0) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
    (pad "2" thru_hole circle (at 2.54 0) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
    (pad "4" thru_hole circle (at -1.10 12.20) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
    (pad "5" thru_hole circle (at 1.44 12.20) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
    (pad "8" thru_hole circle (at 3.98 12.20) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
)